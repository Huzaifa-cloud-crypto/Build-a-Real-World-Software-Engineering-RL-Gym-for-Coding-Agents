{
  "name": "rl-gym-job-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "RL Gym evaluation task for autonomous AI coding agents: Distributed Job Scheduler",
  "scripts": {
    "postinstall": "npm --prefix reference install --silent",
    "build": "npm --prefix reference run build && npm --prefix evaluation run build",
    "generate": "node ./evaluation/dist/scripts/run_external_eval.js",
    "score": "node ./evaluation/dist/src/test_runner.js",
    "check:mutants": "node ./evaluation/dist/src/check_mutants.js",
    "check:reference": "node ./evaluation/dist/src/test_runner.js ./reference/dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^18.0.0"
  }
}
