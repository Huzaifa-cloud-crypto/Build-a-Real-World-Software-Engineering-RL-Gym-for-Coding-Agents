# Model evaluation configuration for `npm run generate`.
# Copy to `.env` and fill in. `.env` is gitignored.

# Two DIFFERENT frontier models, medium reasoning, comma separated.
# Exactly two are required.
EVAL_MODELS=anthropic/claude-opus-5,openai/gpt-5.6-sol

# Credentials OpenHands uses to reach those models.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: explicit path to the OpenHands CLI (auto-detected on PATH otherwise).
# OPENHANDS_BIN=/usr/local/bin/openhands

# Optional: pin the exact headless invocation. Placeholders {bin} {model}
# {workspace} {task} are substituted. Use this if your OpenHands version's
# flags differ from the built-in default.
# OPENHANDS_CMD_TEMPLATE="{bin} --headless --model {model} --workspace {workspace} --task-file {task}"

# Optional: per-model agent timeout in ms (default 3600000 = 1 hour).
# EVAL_TIMEOUT_MS=3600000
